# SERVER ONLY. Copy to .env.local and fill locally. Never use a VITE_ prefix.
DASHSCOPE_API_KEY=
# Use the exact compatible-mode base URL shown by your Bailian workspace/region.
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen-flash
# Per process / per UTC day, memory only. Also set a provider-side spending limit.
BAILIAN_DAILY_LIMIT=20
