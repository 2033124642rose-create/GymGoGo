# SERVER ONLY. Copy to .env.local and fill locally. Never use a VITE_ prefix.
AI_PROVIDER=bailian
AI_API_STYLE=openai-compatible
AI_API_KEY=
# Use the exact compatible-mode base URL shown by your Bailian workspace/region.
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen-flash
# Other OpenAI-compatible providers require an explicit exact hostname allowlist.
# Do not configure another provider until its prices and request format are verified.
AI_ALLOWED_HOSTS=
# Legacy DASHSCOPE_API_KEY / BAILIAN_BASE_URL / BAILIAN_MODEL still work when
# the corresponding AI_* variable is absent, only while AI_PROVIDER=bailian.
# Explicit empty AI_* values disable invalid configuration; they do not fall back.
# Per process / per UTC day, memory only. Also set a provider-side spending limit.
AI_DAILY_LIMIT=20

# SERVER ONLY: leave disabled until a real-call test allowance is explicitly agreed.
GYMGO_QUIZ_ENABLED=false
# Set 1 for a first-level-only local human trial; otherwise all three levels remain available.
QUIZ_MAX_LEVEL=3
# Persistent lifetime call allowance and total CNY budget for the local quiz ledger.
QUIZ_APPROVED_CALLS=0
QUIZ_BUDGET_CNY=0
# Bind verified prices to the selected provider/model. Required when switching away
# from legacy Bailian qwen-flash. Recheck region/pricing before any real call.
QUIZ_PRICE_PROVIDER=bailian
QUIZ_PRICE_MODEL=qwen-flash
# Fill actual prices for AI_MODEL + region, after checking the provider console.
QUIZ_INPUT_CNY_PER_MILLION=
QUIZ_OUTPUT_CNY_PER_MILLION=
QUIZ_PRICE_CHECKED_ON=
