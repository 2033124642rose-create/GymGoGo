    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "miniflare": "^5.20261023.3-beta",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
